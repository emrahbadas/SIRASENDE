CLOUDFLARE_STREAM_CUSTOMER_CODE=

# AI providers
AI_API_KEY=
TRANSCRIPTION_PROVIDER=
TRANSLATION_PROVIDER=

# Email
RESEND_API_KEY=

# Monitoring
SENTRY_DSN=

# Product analytics
POSTHOG_API_KEY=
POSTHOG_HOST=

# Application
APP_ENV=development
APP_URL=
