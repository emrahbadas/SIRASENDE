# Client-safe configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Video provider
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Returned once when the Stream webhook is registered (PUT /stream/webhook)
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# Required: <code> in customer-<code>.cloudflarestream.com (any video's playback URL)
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# AI providers
AI_API_KEY=
TRANSCRIPTION_PROVIDER=
TRANSLATION_PROVIDER=

# Email
RESEND_API_KEY=

# Monitoring
SENTRY_DSN=

# Product analytics
POSTHOG_API_KEY=
POSTHOG_HOST=

# Application
APP_ENV=development
APP_URL=

# Ads (AdMob rewarded unlock)
# Development only: trust the app's "reward earned" report, because AdMob test
# ads never send the signed server callback. Never enable in production.
ADS_TEST_REWARDS=false
# Mobile (EAS build env): AdMob rewarded ad unit ids; Google's test units are used when empty
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
