{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildArtifactPaths": ["android/app/build/outputs/mapping/release/mapping.txt"]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
